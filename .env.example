# IBM WatsonX / Granite Configuration
WATSONX_API_KEY=your_ibm_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM Watson Speech to Text (optional)
WATSON_STT_API_KEY=your_watson_stt_api_key
WATSON_STT_URL=https://api.us-south.speech-to-text.watson.cloud.ibm.com

# Server Configuration
PORT=5000
NODE_ENV=development
